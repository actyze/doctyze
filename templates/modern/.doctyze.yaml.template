# Doctyze configuration for this repository.
# Generated by `doctyze init`. Hand-edits are preserved.
# See https://github.com/actyze/doctyze for full reference.

apiVersion: doctyze/v1
kind: ProjectConfig

stack:
  family: modern              # modern | legacy
  primary: "{{STACK}}"        # java-spring | python | node-react | go | etc.

pr_review:
  # Enforcement mode for the PR review GitHub Action.
  mode: warn-only             # warn-only | block-required | block-all

  # LLM provider for the review agent.
  llm: claude                 # claude | openai | gemini | bedrock | azure | ollama

  # Paths the review agent should NOT analyze.
  exclude_paths:
    - "vendor/**"
    - "node_modules/**"
    - "**/*.generated.*"
    - "test/**"

  # Repo-specific rules layered on top of defaults.
  custom_rules:
    # - "any change to src/payments/** requires PR linked to a JIRA ticket"
    # - "any change touching auth.py requires reviewer from @security-team"

  # Confidence threshold. Suggestions below this are suppressed.
  min_suggestion_confidence: 0.6

extraction:
  # Doctyze's LLM-driven content extraction settings.
  retain_source_locally: true    # never send full repo to a cloud LLM
  audit_log: null                # set to a path to enable local audit logging
  max_files_per_extract: 1000

skills:
  # Default skill library to ship with this repo (mirrors .claude/skills/).
  enabled_skills:
    - write-adr
    - add-new-endpoint
    - update-runbook
    - deprecate-api
    - modify-data-model

confidence:
  # How aggressively to flag artifacts as 🟡 INFERRED vs 🟢 CONFIRMED.
  default_marker: "INFERRED"
  promote_on_human_edit: true   # changing a generated file flips it to CONFIRMED
