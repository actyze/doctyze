# Doctyze configuration for this repository.
# Generated by `doctyze init`. Hand-edits are preserved.
# See https://github.com/actyze/doctyze for full reference.

apiVersion: doctyze/v1
kind: ProjectConfig

stack:
  family: modern              # modern | legacy
  primary: "{{STACK}}"        # java-spring | python | node-react | go | etc.

# ── Canonical source of truth ──
# Skills live in docs/skills/*.md as canonical markdown (+ YAML frontmatter).
# Runbooks live in docs/runbooks/*.md as canonical markdown (+ frontmatter).
# All vendor-specific files (.claude/skills/, .cursor/rules/,
# .github/copilot-instructions.md, .windsurfrules, .holmes/runbooks/) are
# *generated* from these canonical sources via `doctyze render`.
#
# Edit the canonical files. Re-render with `doctyze render` (or let the
# GitHub Action handle it on push).

agent_targets:
  # Which AI tools this repo targets. Each entry maps to a renderer.
  # Run `doctyze render --list` to see available renderers.
  - claude                    # → .claude/skills/<name>/SKILL.md
  - cursor                    # → .cursor/rules/<name>.md
  - copilot                   # → .github/copilot-instructions.md (single concatenated file)
  - holmes                    # → .holmes/runbooks/<id>.yaml (from docs/runbooks/)
  # - windsurf                # → .windsurfrules (single concatenated file)
  # - codex                   # Reads AGENTS.md directly (no extra renderer needed)

render:
  commit_generated: true      # commit generated vendor files (recommended for OSS-style repos)
  pre_commit_hook: false
  github_action: true         # .github/workflows/doctyze-render.yml regenerates on push

pr_review:
  mode: warn-only             # warn-only | block-required | block-all
  llm: claude
  exclude_paths:
    - "vendor/**"
    - "node_modules/**"
    - "**/*.generated.*"
    - "test/**"
  custom_rules: []
  min_suggestion_confidence: 0.6

extraction:
  retain_source_locally: true
  audit_log: null
  max_files_per_extract: 1000

confidence:
  default_marker: "INFERRED"
  promote_on_human_edit: true
